# NeverDown — copy to .env (never commit .env)

# Hedera network (testnet only for C1–C3)
HEDERA_NETWORK=testnet

# Operator (C3 HCS) — may reuse spend account for hackathon
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Created via: pnpm hcs:create-topic
HEDERA_TOPIC_ID=

# Buyer / spend wallet (C2+) — funded Hedera testnet account that PAYS
HEDERA_SPEND_ID=
HEDERA_SPEND_KEY=

# C3 policy
POLICY_CAP_TINYBARS=50000
POLICY_SPENT_TINYBARS=0
POLICY_ALLOWLIST=neverdown-rpc:0.0.YOUR_MERCHANT_ACCOUNT
POLICY_VERSION=c3-v1

# x402 facilitator
X402_FACILITATOR_URL=https://x402.org/facilitator

# Seller URL for pay-once / policy smoke (C2+)
SELLER_URL=http://localhost:4001

# --- Sellers (C1+) ---
SELLER_PORT=4001
# Public Hedera account that RECEIVES payment (not a private key)
HEDERA_MERCHANT_ACCOUNT_ID=
HEDERA_X402_ASSET_ID=0.0.0
HEDERA_X402_PRICE_SMALLEST_UNITS=10000
RPC_MODE=mock
# Required only when RPC_MODE=upstream
RPC_UPSTREAM_URL=

# Arkiv (C5+)
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=

# ENS (C6+)
ENS_RPC_URL=
ENS_ALLOWLIST_NAMES=

# Agent LLM (C8+)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Gateway (C4+)
GATEWAY_PRIMARY_RPC=
GATEWAY_STANDBY_RPC=
GATEWAY_PORT=8787
