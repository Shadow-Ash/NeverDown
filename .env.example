# NeverDown — copy to .env and fill for later chunks (C1+)

# Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_SPEND_ID=
HEDERA_SPEND_KEY=
HEDERA_TOPIC_ID=

# Arkiv (Rabdi testnet)
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=

# ENS (Sepolia)
ENS_RPC_URL=
ENS_ALLOWLIST_NAMES=

# Agent LLM (C8+)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Gateway RPCs (C4+)
GATEWAY_PRIMARY_RPC=
GATEWAY_STANDBY_RPC=
GATEWAY_PORT=8787

# Sellers — x402 RPC merchant (C1)
# Port the seller listens on.
SELLER_PORT=4001
# HEDERA_NETWORK (above) must be testnet for C1.
# Your Hedera testnet account that receives payments (public account id, not a key). Required.
HEDERA_MERCHANT_ACCOUNT_ID=
# Price asset. 0.0.0 = HBAR (amounts in tinybars). Otherwise an HTS token id.
HEDERA_X402_ASSET_ID=0.0.0
# Price in smallest units (integer). 10000 tinybars = 0.0001 HBAR.
HEDERA_X402_PRICE_SMALLEST_UNITS=10000
# Facilitator that verifies and settles payments. Official x402 testnet facilitator.
X402_FACILITATOR_URL=https://x402.org/facilitator
# mock = built-in deterministic chain responses. upstream = forward paid calls to RPC_UPSTREAM_URL.
RPC_MODE=mock
# Required only when RPC_MODE=upstream. Fixed URL; the seller never accepts a URL from clients.
RPC_UPSTREAM_URL=
