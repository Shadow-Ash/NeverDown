# NeverDown — copy to .env (never commit .env)

# Hedera network (testnet only for C1–C3)
HEDERA_NETWORK=testnet

# Operator (C3 HCS) — may reuse spend account for hackathon
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=

# Buyer / spend wallet (C2+) — funded Hedera testnet account that PAYS
HEDERA_SPEND_ID=
HEDERA_SPEND_KEY=

# x402 facilitator
X402_FACILITATOR_URL=https://x402.org/facilitator

# Seller URL for pay-once / policy smoke (C2+)
SELLER_URL=http://localhost:4001

# --- Sellers (C1+) ---
SELLER_PORT=4001
SELLER_ENTITLEMENT_DB_PATH=neverdown-seller.sqlite
# Public Hedera account that RECEIVES payment (not a private key)
HEDERA_MERCHANT_ACCOUNT_ID=
HEDERA_X402_ASSET_ID=0.0.0
HEDERA_X402_PRICE_SMALLEST_UNITS=10000
RPC_MODE=mock
# Required only when RPC_MODE=upstream
RPC_UPSTREAM_URL=

# Arkiv (C5+)
# Arkiv Rabdi (C5) — https://hub.arkiv.network/access-keys + /faucet
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=

# ENS (C6+)
ENS_RPC_URL=
ENS_ALLOWLIST_NAMES=

# Proof-of-Capability (C7)
POC_CANDIDATE_RPC=
POC_REFERENCE_RPC=
POC_EXPECTED_CHAIN_ID=11155111

# Agent LLM (C8+)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Gateway (C4+)
GATEWAY_PORT=8787
GATEWAY_CHAIN_ID=11155111
GATEWAY_PRIMARY_RPC_URL=
GATEWAY_STANDBY_RPC_URL=
GATEWAY_HEALTH_INTERVAL_MS=5000
GATEWAY_REQUEST_TIMEOUT_MS=3000
GATEWAY_FAILURE_THRESHOLD=3
GATEWAY_RECOVERY_THRESHOLD=3
GATEWAY_STALE_BLOCK_TOLERANCE=20
GATEWAY_FAILOVER_COOLDOWN_MS=15000
GATEWAY_INTERNAL_API=false
GATEWAY_INTERNAL_TOKEN=
# Backward-compatible aliases:
GATEWAY_PRIMARY_RPC=
GATEWAY_STANDBY_RPC=

# --- C3 Policy / Audit ---
POLICY_ID=neverdown-demo-v1
POLICY_VERSION=1
POLICY_CAP_TINYBARS=30000
POLICY_SPENT_TINYBARS=0
# Comma-separated Hedera merchant account ids (payTo allowlist)
POLICY_ALLOWLIST=0.0.YOUR_MERCHANT_ACCOUNT
POLICY_SERVICES=neverdown-rpc-pack
POLICY_EXPIRES_AT=
POLICY_MAX_PER_PAYMENT_TINYBARS=10000
POLICY_TOTAL_BUDGET_TINYBARS=
POLICY_DB_PATH=
HCS_AUDIT_AVAILABILITY=REQUIRED_DURABLE
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Payment worker (C3 isolation)
# Separate secret file for untrusted agent host. Created by developer, mode 0600.
PAYMENT_WORKER_ENV_FILE=.env.worker
INCIDENT_DB_PATH=neverdown-incidents.sqlite
POLICY_ENDPOINTS=
POLICY_AUTH_TTL_SECONDS=
