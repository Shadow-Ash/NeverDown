# Copy to .env.worker (ignored by Git), then chmod 600 .env.worker.
# Use a funded Hedera testnet account and an HCS topic you control.
HEDERA_NETWORK=testnet
HEDERA_SPEND_ID=
HEDERA_SPEND_KEY=
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HCS_AUDIT_AVAILABILITY=REQUIRED_DURABLE
HEDERA_X402_ASSET_ID=0.0.0
HEDERA_MERCHANT_ACCOUNT_ID=
HEDERA_X402_PRICE_SMALLEST_UNITS=10000
POLICY_ALLOWLIST=
POLICY_SERVICES=neverdown-rpc-pack
POLICY_ENDPOINTS=http://localhost:4001
POLICY_MAX_PER_PAYMENT_TINYBARS=10000
POLICY_TOTAL_BUDGET_TINYBARS=30000
POLICY_DB_PATH=neverdown-policy.sqlite
