{
  "name": "neverdown",
  "private": true,
  "version": "0.0.0",
  "description": "NeverDown — Autonomous Resilience Operator for Web3",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "pay:once": "node --env-file-if-exists=.env --import tsx scripts/pay-once.ts",
    "policy:smoke": "node --env-file-if-exists=.env --import tsx scripts/policy-smoke.ts",
    "hcs:smoke": "node --env-file-if-exists=.env --import tsx scripts/hcs-smoke.ts",
    "env:bootstrap": "node scripts/bootstrap-live-env.mjs",
    "arkiv:seed": "node --env-file-if-exists=.env.arkiv-seed --import tsx scripts/seed-arkiv.ts",
    "arkiv:query": "node --env-file-if-exists=.env.agent --import tsx scripts/query-arkiv.ts",
    "ens:check": "node --env-file-if-exists=.env.agent --import tsx scripts/check-ens.ts",
    "ens:set-texts": "node --env-file-if-exists=.env.agent --import tsx scripts/set-ens-texts.ts",
    "preflight:live": "node --env-file-if-exists=.env.agent --import tsx scripts/live-preflight.ts",
    "seller:live": "node --env-file-if-exists=.env.seller --import tsx apps/sellers/src/server.ts",
    "gateway:live": "node --env-file-if-exists=.env.agent --import tsx apps/gateway/src/server.ts",
    "poc:smoke": "node --env-file-if-exists=.env --import tsx scripts/poc-smoke.ts",
    "agent:demo": "node --env-file-if-exists=.env --import tsx scripts/agent-demo.ts",
    "agent:live": "node --env-file-if-exists=.env.agent --import tsx scripts/agent-demo.ts --scenario procure --live",
    "agent:deny-live": "node --env-file-if-exists=.env.agent --import tsx scripts/agent-demo.ts --scenario deny --live",
    "coordinator:dev": "node --env-file-if-exists=.env --import tsx scripts/incident-coordinator.ts",
    "coordinator:live": "node --env-file-if-exists=.env.agent --import tsx scripts/incident-coordinator.ts",
    "web:dev": "pnpm --filter @neverdown/web dev",
    "test:core": "pnpm --filter @neverdown/core test",
    "test:sellers": "pnpm --filter @neverdown/sellers test",
    "test:gateway": "pnpm --filter @neverdown/gateway test"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  },
  "pnpm": {
    "overrides": {
      "@hiero-ledger/sdk": "2.90.1",
      "@hiero-ledger/proto": "2.32.0"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
